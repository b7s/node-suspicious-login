{
  "name": "node-suspicious-login",
  "version": "0.1.0",
  "description": "Node.js equivalent of laravel-suspicious-login. Detects suspicious logins by scoring signals, with presets, actions and configurable thresholds. Framework-agnostic core with Express adapter.",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "duplication": "jscpd src --threshold 0 --min-lines 4 --min-tokens 25 --reporters console"
  },
  "keywords": [
    "suspicious-login",
    "login-detection",
    "auth-security",
    "express",
    "fastify",
    "nestjs",
    "bun",
    "scoring",
    "presets"
  ],
  "author": "Davi",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "maxmind": "^5.1.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "eslint": "^9.0.0",
    "express": "^4.19.0",
    "fastify": "^5.12.8",
    "jest": "^29.0.0",
    "jscpd": "5.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.0.0"
  },
  "files": [
    "src/"
  ]
}
