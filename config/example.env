# Suspicious login detection thresholds
SUSPICIOUS_SCORE_MEDIUM=40
SUSPICIOUS_SCORE_HIGH=70

# Default preset: default | admin
SUSPICIOUS_DEFAULT_PRESET=default

# IP geolocation provider: ipapi | local
SUSPICIOUS_IP_PROVIDER=ipapi
# SUSPICIOUS_IP_PROVIDER_URL=https://ipapi.co/json/

# SMTP (email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Application base URL (used in emails)
APP_URL=http://localhost:3000