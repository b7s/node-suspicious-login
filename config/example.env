# Read these values in your application and pass them to SuspiciousLogin.open().
# The library does not load environment variables automatically.
SUSPICIOUS_DB_PATH=./suspicious-login.sqlite
# Optional MaxMind GeoLite2 City database (download separately).
GEOLITE2_CITY_PATH=/path/to/GeoLite2-City.mmdb

# Optional SMTP settings for an application-created Nodemailer transporter.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
